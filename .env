DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=daily-expense
DB_PORT=5432
DB_URL=postgres://postgres:postgres@localhost:5432/daily-expense?sslmode=disable

# Port backend Go. Next.js dev memakai :3000, jadi backend pakai port lain.
PORT=8000
# Asal yang diizinkan mengakses API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT_SECRET TIDAK disimpan di file ini (file ini di-track git).
# Untuk lokal, isi di .env.local (gitignored). Di produksi diisi deploy.sh
# dari GitHub Actions secret.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
