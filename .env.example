DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=daily-expense
DB_PORT=5432

# Port backend Go (default 3000). Karena Next.js dev memakai :3000,
# gunakan port lain agar tidak bentrok.
PORT=8000
# Asal yang diizinkan mengakses API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000