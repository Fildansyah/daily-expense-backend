DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=daily-expense
DB_PORT=5432

# Dipakai oleh `make migrate-up/down` (wajib diakhiri ?sslmode=disable untuk
# PostgreSQL lokal/container yang SSL-nya dimatikan).
DB_URL=postgres://postgres:admin@localhost:5432/daily-expense?sslmode=disable

# Port backend Go (default 8000).
# gunakan port lain agar tidak bentrok dengan Next.js :3000.
PORT=8000
# Asal yang diizinkan mengakses API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth ---
# Di produksi nilai ini diisi otomatis oleh deploy.sh dari GitHub Actions secret.
# Untuk development lokal, isi manual: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# true jika diakses via HTTPS (VPS + Caddy), false untuk http lokal
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
